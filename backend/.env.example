# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nips_db
# Or full connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nips_db

# Snort Fast-Alert Log Monitoring
# Set to your live Snort sensor fast-alert file path (e.g., /var/log/snort/snort.alert.fast or ./mock_snort.log)
SNORT_LOG_PATH=/var/log/snort/snort.alert.fast

# Firewall Prevention Engine Mode
# If true: Executes real kernel command 'sudo iptables -A INPUT -s <ip> -j DROP' (requires Linux root/sudo)
# If false: Safely simulates the action by logging the exact command to the console
ENABLE_REAL_IPTABLES=true
