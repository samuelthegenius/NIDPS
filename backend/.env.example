# =============================================================================
# NIDPS configuration. Copy to .env (or run `npm run setup`, which does it).
# Restart NIDPS after changing anything here.
# =============================================================================

# --- Web server --------------------------------------------------------------
PORT=5000
# 0.0.0.0 = reachable from other machines on the LAN; 127.0.0.1 = this machine only
HOST=0.0.0.0
NODE_ENV=production
# Optional HTTPS (recommended on shared campus Wi-Fi). Create with scripts/gen-cert.sh
# TLS_CERT=../certs/nidps.crt
# TLS_KEY=../certs/nidps.key

# --- Admin login (set by `npm run setup` - do not edit by hand) ---------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Deployment mode -----------------------------------------------------------
# host    = protect this machine (iptables INPUT chain)
# gateway = protect the network routed through this machine (FORWARD chain);
#           see docs/LAN_DEPLOYMENT.md
NIDPS_MODE=host

# true  = really run iptables (Linux root/passwordless sudo, or WSL on Windows)
# false = only log the exact iptables command (safe for development and rehearsal)
ENABLE_REAL_IPTABLES=false
# WSL distribution used on Windows for iptables and Snort
WSL_DISTRO=Ubuntu-24.04

# true = enable the attack simulator in the dashboard (for demos). Use false in real use.
DEMO_MODE=true

# --- Protection policy ----------------------------------------------------------
# Addresses that must NEVER be blocked (comma-separated IPs or CIDR ranges):
# your gateway/router, DNS servers, the admin PC. This machine's own addresses
# and loopback are always protected automatically.
NIDPS_ALLOWLIST=
# How long a block lasts before it is lifted automatically (minutes, 0 = permanent)
BLOCK_DURATION_MIN=60
# Block a source after this many Priority-2 alerts within the window (0 = off)
ESCALATE_COUNT=5
ESCALATE_WINDOW_MIN=5
# Delete alerts and audit entries older than this many days (0 = keep forever)
RETENTION_DAYS=30

# --- Snort ---------------------------------------------------------------------------
# Linux:   /var/log/snort/snort.alert.fast
# Windows + WSL: \\wsl.localhost\Ubuntu-24.04\var\log\snort\snort.alert.fast
# Development without Snort: ./mock_snort.log
SNORT_LOG_PATH=./mock_snort.log
SNORT_INTERFACE=eth0

# --- Database (PostgreSQL). If unreachable, NIDPS runs with an in-memory store. ------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=nidps_db
# Or one connection string:
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/nidps_db
