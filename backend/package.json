{
  "name": "nidps-backend",
  "version": "1.0.0",
  "description": "Network Intrusion Detection and Prevention System (NIDPS) Control Server",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/config/initDb.js",
    "simulate": "node scripts/generateMockLogs.js",
    "reset": "node scripts/resetData.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "setup": "node scripts/setup-admin.js"
  },
  "keywords": [
    "nidps",
    "snort",
    "ids",
    "firewall",
    "security",
    "iptables"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "tail": "^2.2.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
